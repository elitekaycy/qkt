# Profile for scripts/live-validation/run-attestation.sh. Copy outside the repo and edit.
# No secret belongs here: the broker key comes from QKT_BROKER_API_KEY in the environment.
gateway_url=http://127.0.0.1:5001
expected_login=436804390
expected_server=Exness-MT5Trial9
expected_leverage=1000
wave_root=/var/tmp/qkt-validation
bundle_root=/var/lib/qkt/soak
image_repository=ghcr.io/elitekaycy/qkt
insights_image=ghcr.io/elitekaycy/qkt-insights:latest
magic_base=994000
# A clone of elitekaycy/qkt-data-corpus (private) for the release proofs; moved to tests/data-e2e/corpus.lock.
data_corpus=/var/tmp/qkt-validation/data-corpus
# Optional: the local store the docs examples read (eight months of gold and bitcoin ticks); adds them to the proofs.
#docs_data_root=/home/<you>/.qkt/data
# Optional: a VGP gateway on a demo/testnet account (e.g. Deribit testnet) adds the derivatives lane.
# Its trader token comes from QKT_DERIV_GATEWAY_KEY in the environment.
#deriv_gateway_url=http://127.0.0.1:8444
#deriv_expected_login=g-aVrEeP
# Optional: a gateway running the Bybit adapter on a Bybit testnet account adds the bybit lane.
# Its trader token comes from QKT_BYBIT_GATEWAY_KEY (guardian: QKT_BYBIT_GUARDIAN_KEY).
#bybit_gateway_url=http://127.0.0.1:18445
#bybit_expected_login=<the account_login its /v1/health reports>
# Optional: gateway venues for the cross lane (one daemon on this MT5 demo and them), LABEL=URL@LOGIN, space separated.
# The shipped cases name PAPER, the built-in paper adapter. Tokens: QKT_CROSS_<LABEL>_KEY, QKT_CROSS_<LABEL>_GUARDIAN_KEY.
#cross_venues="PAPER=http://127.0.0.1:18443@paper"
# Optional preflight limits (defaults are proposals: 5 GB, 4 GB, 1500 ms median over five gateway reads).
#preflight_min_disk_gb=5
#preflight_min_mem_gb=4
#preflight_max_latency_ms=1500
# Optional: how far ahead a session lane's window (stocks, alpaca) may be, in hours. Outside its window the run does every
# other lane now and waits for it; only a window further away than this stops the run at preflight. 72 covers a weekend.
#session_wait_max_h=72
