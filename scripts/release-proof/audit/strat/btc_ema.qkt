STRATEGY btc_ema VERSION 1

SYMBOLS
  btc = BACKTEST:BTCUSD EVERY 15m WARMUP 220 BARS

RULES
  WHEN ema(btc.close, 9) CROSSES ABOVE ema(btc.close, 21)
   AND POSITION.btc = 0
  THEN BUY btc SIZING 0.5 PCT RISK
       BRACKET { STOP_LOSS AT btc.close - atr(btc, 14) * 1.5, TAKE_PROFIT AT btc.close + atr(btc, 14) * 2.25 }

  WHEN ema(btc.close, 9) CROSSES BELOW ema(btc.close, 21)
   AND POSITION.btc = 0
  THEN SELL btc SIZING 0.5 PCT RISK
       BRACKET { STOP_LOSS AT btc.close + atr(btc, 14) * 1.5, TAKE_PROFIT AT btc.close - atr(btc, 14) * 2.25 }
