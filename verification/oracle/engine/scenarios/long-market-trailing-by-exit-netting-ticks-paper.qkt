STRATEGY long_market_trailing_by_exit_netting_ticks_paper VERSION 1
-- on a netted long, SELL TRAILING BY 0.40 rides the high to 101.60 and closes the long on a 0.41 reversal
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1
    WHEN syn.close = 101.00 AND POSITION.syn > 0
    THEN SELL syn SIZING 0.1 ORDER_TYPE = TRAILING BY 0.40
