STRATEGY long_trailing_pct_entry_fires_on_reversal_ticks_paper VERSION 1
-- BUY TRAILING PCT 0.5 ratchets its low-water mark to 99.40 and buys at market when the mark rises 0.5 %
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 ORDER_TYPE = TRAILING PCT 0.5
    WHEN syn.close = 100.20 AND POSITION.syn > 0
    THEN CLOSE syn
