STRATEGY long_market_entry_and_stop_same_bar_bars_synthetic_paper VERSION 1
-- the entry fills at the bar open and the same bar's low takes the stop at its level
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 }
