STRATEGY long_market_bracket_by_stop_ticks_paper_netting VERSION 1
-- the same long stop round trip on a netting account books the same tape
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 }
