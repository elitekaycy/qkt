STRATEGY long_limit_exit_after_from_fill_ticks_paper VERSION 1
-- a LIMIT entry filling 45 s after placement closes 1m after its fill, not 1m after the signal
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 ORDER_TYPE = LIMIT AT 100.00 EXIT AFTER 1m
