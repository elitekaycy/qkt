STRATEGY short_market_armed_trailing_stop_pre_arm_hit_ticks_paper VERSION 1
-- a SELL armed trailing stop that never arms stops out at its pre-arm level entry + 0.60
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN SELL syn SIZING 0.1 BRACKET { STOP LOSS TRAILING 0.60 AFTER MFE >= 1.00, TAKE PROFIT BY 3.00 }
