STRATEGY long_market_stop_through_bars_synthetic_paper VERSION 1
-- a stop the bar trades through fills at its level, not at the bar low
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 }
