STRATEGY long_stop_oto_limit_child_at_stop_price_netting_ticks_paper VERSION 1
-- for a STOP parent `entry` is its price 101.00: the child limit rests at 100.50 and fills on the dip
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 ORDER_TYPE = STOP AT 101.00 ON_FILL { BUY syn SIZING 0.05 ORDER_TYPE = LIMIT AT entry - 0.50 }
    WHEN syn.close = 101.30 AND POSITION.syn > 0
    THEN CLOSE syn
