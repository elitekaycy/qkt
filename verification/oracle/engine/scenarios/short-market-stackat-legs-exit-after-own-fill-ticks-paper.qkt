STRATEGY short_market_stackat_legs_exit_after_own_fill_ticks_paper VERSION 1
-- EXIT AFTER 1m with STACK_AT: the primary closes 60 s after its fill, the tier leg 60 s after its own (30 s later)
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN SELL syn SIZING 0.1
        STACK_AT MFE >= 0.30 WITHIN 5m SIZING 0.05 BRACKET { STOP LOSS BY 1.00, TAKE PROFIT BY 2.00 } EXIT AFTER 1m
