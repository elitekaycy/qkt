STRATEGY short_market_sizing_risk_usd_below_min_rejected_ticks_paper VERSION 1
-- SIZING RISK $ 0.1 over a 2.00 stop and contractSize 10 is 0.005 lots, below volumeMin: rejected, no trade
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN SELL syn SIZING RISK $ 0.1 BRACKET { STOP_LOSS BY 2.00, TAKE_PROFIT BY 4.00 }
