STRATEGY oco_entry_gap_equal_distance_listing_order_ticks_paper VERSION 1
-- two legs at the same distance from the previous tick: the one written first fills, the other is cancelled
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50
    THEN OCO_ENTRY {
        BUY syn SIZING 0.1 ORDER_TYPE = LIMIT AT 99.70 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 1.00 },
        SELL syn SIZING 0.1 ORDER_TYPE = STOP AT 99.70 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 1.00 }
    }
