STRATEGY short_market_oto_limit_child_never_fills_netting_ticks_paper VERSION 1
-- a SELL LIMIT AT entry + 0.50 child the bid never reaches stays out of the position; CLOSE takes the parent only
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN SELL syn SIZING 0.1 ON_FILL { SELL syn SIZING 0.05 ORDER_TYPE = LIMIT AT entry + 0.50 }
    WHEN syn.close = 100.05 AND POSITION.syn < 0
    THEN CLOSE syn
