STRATEGY short_market_gap_stop_ticks_mt5_slippage VERSION 1
-- a tick that gaps through a short stop fills at that tick's ask plus slippage
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN SELL syn SIZING 0.1 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 }
