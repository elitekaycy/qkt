STRATEGY long_market_bracket_by_stop_ticks_paper VERSION 1
-- a long stop triggers on the bid touching the level and fills at that tick's mid, half a spread above it
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 }
