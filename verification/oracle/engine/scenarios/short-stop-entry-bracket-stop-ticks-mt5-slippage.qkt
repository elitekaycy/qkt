STRATEGY short_stop_entry_bracket_stop_ticks_mt5_slippage VERSION 1
-- mt5-sim slips a sell-stop entry and its protective buy-stop by slippagePoints, both against the trade
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN SELL syn SIZING 0.1 ORDER_TYPE = STOP AT 100.00 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 1.00 }
