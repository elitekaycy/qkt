STRATEGY long_market_bracket_pct_halftick_target_ticks_paper VERSION 1
-- PCT levels 99.495 and 103.515 land on the grid toward the entry (99.50 / 103.51); the target fills
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 BRACKET { STOP_LOSS BY 1 PCT, TAKE_PROFIT BY 3 PCT }
