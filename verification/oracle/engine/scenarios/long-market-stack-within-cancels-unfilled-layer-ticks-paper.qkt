STRATEGY long_market_stack_within_cancels_unfilled_layer_ticks_paper VERSION 1
-- WITHIN 1m from the seed fill: layer 2 fills inside it, layer 3's rung is reached after it and never fills
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 STACK 3 SPACING 0.50 ABOVE WITHIN 1m BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 3.00 }
