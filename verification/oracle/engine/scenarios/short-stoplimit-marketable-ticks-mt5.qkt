STRATEGY short_stoplimit_marketable_ticks_mt5 VERSION 1
-- a sell stop-limit whose trigger bid 99.94 already satisfies its 99.90 limit fills on that tick at the bid
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN SELL syn SIZING 0.1 ORDER_TYPE = STOP AT 100.00 LIMIT AT 99.90 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 1.00 }
