STRATEGY oco_entry_gap_closer_leg_listed_first_bars_synthetic_paper VERSION 1
-- a bar opening beyond both legs fills the leg closer to the open even when it is listed first
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50
    THEN OCO_ENTRY {
        BUY syn SIZING 0.1 ORDER_TYPE = LIMIT AT 99.00 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 1.00 },
        SELL syn SIZING 0.1 ORDER_TYPE = STOP AT 99.50 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 1.00 }
    }
