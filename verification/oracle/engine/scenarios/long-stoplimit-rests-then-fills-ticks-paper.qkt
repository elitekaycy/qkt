STRATEGY long_stoplimit_rests_then_fills_ticks_paper VERSION 1
-- once the stop trades, a limit rests at the limit price and fills when the ask comes back to it
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 ORDER_TYPE = STOP AT 101.00 LIMIT AT 101.10 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 1.00 }
