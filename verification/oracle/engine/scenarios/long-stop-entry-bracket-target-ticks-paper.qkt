STRATEGY long_stop_entry_bracket_target_ticks_paper VERSION 1
-- a buy stop triggers on the ask reaching it and fills at mid; its target then fills
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 ORDER_TYPE = STOP AT 101.00 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 1.00 }
