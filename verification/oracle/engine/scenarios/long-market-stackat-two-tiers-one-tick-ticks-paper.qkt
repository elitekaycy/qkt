STRATEGY long_market_stackat_two_tiers_one_tick_ticks_paper VERSION 1
-- one tick lifts MFE past both 0.30 and 0.60: both tiers fire on it, each with its own size and bracket
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 3.00 }
        STACK_AT MFE >= 0.30 WITHIN 5m SIZING 0.05 BRACKET { STOP LOSS BY 1.00, TAKE PROFIT BY 0.50 }
        STACK_AT MFE >= 0.60 WITHIN 5m SIZING 0.03 BRACKET { STOP LOSS BY 1.00, TAKE PROFIT BY 0.80 }
