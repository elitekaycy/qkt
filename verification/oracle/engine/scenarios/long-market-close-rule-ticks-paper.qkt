STRATEGY long_market_close_rule_ticks_paper VERSION 1
-- CLOSE from a bar-close rule flattens at the first tick after that close
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1
    WHEN syn.close = 103.00 AND POSITION.syn > 0
    THEN CLOSE syn
