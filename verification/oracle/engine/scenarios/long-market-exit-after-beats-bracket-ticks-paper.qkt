STRATEGY long_market_exit_after_beats_bracket_ticks_paper VERSION 1
-- the timer fires before the bracket: the bracket is cancelled, so the later dip through the old stop sends nothing
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 } EXIT AFTER 1m
