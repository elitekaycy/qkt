STRATEGY long_market_sizing_pct_risk_step_rounding_ticks_paper VERSION 1
-- SIZING 0.5 PCT RISK with a 1.50 stop and contractSize 10 is 3.333 lots, quantized down to 3.33
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.5 PCT RISK BRACKET { STOP_LOSS BY 1.50, TAKE_PROFIT BY 3.00 }
