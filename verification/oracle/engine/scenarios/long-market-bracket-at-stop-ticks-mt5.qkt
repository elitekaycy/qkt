STRATEGY long_market_bracket_at_stop_ticks_mt5 VERSION 1
-- mt5-sim buys the entry at the ask and sells the stop at the bid, no slippage configured
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 BRACKET { STOP_LOSS AT 99.50, TAKE_PROFIT AT 102.50 }
