STRATEGY long_market_samebar_both_bars_synthetic_paper VERSION 1
-- a bar spanning both levels replays its adverse extreme first: the long exits at the stop level
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 }
