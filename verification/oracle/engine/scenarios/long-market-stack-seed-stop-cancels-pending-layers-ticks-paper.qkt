STRATEGY long_market_stack_seed_stop_cancels_pending_layers_ticks_paper VERSION 1
-- the seed stops out before any layer triggers, so the unfilled layers cancel and a later rally adds nothing
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 STACK 3 SPACING 0.50 ABOVE BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 3.00 }
