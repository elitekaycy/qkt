STRATEGY short_market_bracket_stop_bars_ticks_paper VERSION 1
-- --bars with tick-resolved fills books the short stop exactly as the tick replay does
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN SELL syn SIZING 0.1 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 }
