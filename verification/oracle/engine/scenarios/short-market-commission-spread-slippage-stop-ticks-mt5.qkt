STRATEGY short_market_commission_spread_slippage_stop_ticks_mt5 VERSION 1
-- mt5-sim with commission, feed spread and slippage: entry at bid minus slip, stop at ask plus slip, 0.35 per fill
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN SELL syn SIZING 0.1 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 }
