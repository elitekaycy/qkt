STRATEGY short_market_oco_target_ticks_paper VERSION 1
-- OCO { STOP AT, LIMIT AT } protects a short; the limit fills and the stop is cancelled
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN SELL syn SIZING 0.1 OCO { STOP AT 101.50, LIMIT AT 98.50 }
