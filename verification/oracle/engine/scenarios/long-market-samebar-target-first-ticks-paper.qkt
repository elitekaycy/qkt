STRATEGY long_market_samebar_target_first_ticks_paper VERSION 1
-- when one bar's ticks cross the target and then the stop, the target fills and the stop is cancelled
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 }
