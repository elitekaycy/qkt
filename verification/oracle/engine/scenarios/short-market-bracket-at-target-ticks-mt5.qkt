STRATEGY short_market_bracket_at_target_ticks_mt5 VERSION 1
-- mt5-sim sells the entry at the bid and buys the target at the ask, a limit never filled worse than its price
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN SELL syn SIZING 0.1 BRACKET { STOP_LOSS AT 101.50, TAKE_PROFIT AT 98.50 }
