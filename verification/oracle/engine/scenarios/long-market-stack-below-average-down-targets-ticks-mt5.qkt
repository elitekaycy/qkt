STRATEGY long_market_stack_below_average_down_targets_ticks_mt5 VERSION 1
-- mt5-sim average-down: the seed buys at ask plus slip, the layer limit at seed fill - 0.50 fills unslipped
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 STACK 2 SPACING 0.50 BELOW BRACKET { STOP_LOSS BY 2.00, TAKE_PROFIT BY 1.00 }
