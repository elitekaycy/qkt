STRATEGY short_market_samebar_stop_first_ticks_paper VERSION 1
-- a short whose bar crosses the stop before the target exits at the stop
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN SELL syn SIZING 0.1 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 }
