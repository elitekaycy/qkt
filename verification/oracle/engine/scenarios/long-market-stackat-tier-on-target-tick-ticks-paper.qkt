STRATEGY long_market_stackat_tier_on_target_tick_ticks_paper VERSION 1
-- one gap tick fills the primary's target and lifts MFE past the tier: the tier fires on it and its leg runs on
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 1.00 }
        STACK_AT MFE >= 0.90 WITHIN 5m SIZING 0.05 BRACKET { STOP LOSS BY 0.50, TAKE PROFIT BY 0.50 }
