STRATEGY long_market_stack_above_layer_slipped_ticks_mt5 VERSION 1
-- mt5-sim pyramid: the rung hangs off the slipped seed fill (101.03) and the layer stop fills at ask plus slip
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 STACK 2 SPACING 0.50 ABOVE BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 }
