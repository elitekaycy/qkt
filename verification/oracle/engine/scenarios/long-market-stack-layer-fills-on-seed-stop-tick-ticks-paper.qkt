STRATEGY long_market_stack_layer_fills_on_seed_stop_tick_ticks_paper VERSION 1
-- one gap tick reaches the average-down layer and the seed's stop: the layer fills, the seed stops, the layer runs on
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 STACK 2 SPACING 0.50 BELOW BRACKET { STOP_LOSS BY 0.80, TAKE_PROFIT BY 1.00 }
