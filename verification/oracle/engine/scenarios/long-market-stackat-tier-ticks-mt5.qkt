STRATEGY long_market_stackat_tier_ticks_mt5 VERSION 1
-- mt5-sim: MFE is the mark against the 100.52 fill; the tier leg buys at ask plus slip, its bracket on that fill
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 }
        STACK_AT MFE >= 0.50 WITHIN 5m SIZING 0.05 BRACKET { STOP LOSS BY 0.40, TAKE PROFIT BY 0.60 }
