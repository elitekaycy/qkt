STRATEGY short_market_exit_after_off_tick_deadline_ticks_mt5 VERSION 1
-- EXIT AFTER 100s lands between ticks: the close is the first tick at or after fill + 100 s, at ask plus slip
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN SELL syn SIZING 0.1 EXIT AFTER 100s
