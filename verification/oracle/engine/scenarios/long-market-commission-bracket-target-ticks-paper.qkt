STRATEGY long_market_commission_bracket_target_ticks_paper VERSION 1
-- commissionPerLot 7 charges 0.70 on the 0.1-lot entry and again on the exit; realised is net per fill
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 }
