STRATEGY long_market_armed_trailing_stop_trails_hwm_ticks_paper VERSION 1
-- STOP LOSS TRAILING 0.50 AFTER MFE >= 0.80 arms at 101.30, trails the 101.70 high to 101.20, stops on the reversal
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 BRACKET { STOP LOSS TRAILING 0.50 AFTER MFE >= 0.80, TAKE PROFIT BY 3.00 }
