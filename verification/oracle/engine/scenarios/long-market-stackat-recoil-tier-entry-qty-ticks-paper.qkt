STRATEGY long_market_stackat_recoil_tier_entry_qty_ticks_paper VERSION 1
-- MAE 0.50 arms the recoil tier, the anchor floats to 99.70, a 0.30 recovery fires ENTRY_QTY * 0.5
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.2 BRACKET { STOP_LOSS BY 1.50, TAKE_PROFIT BY 2.00 }
        STACK_AT MAE >= 0.50 RECOVER 0.30 WITHIN 5m SIZING ENTRY_QTY * 0.5 BRACKET { STOP LOSS BY 0.50, TAKE PROFIT BY 0.40 }
