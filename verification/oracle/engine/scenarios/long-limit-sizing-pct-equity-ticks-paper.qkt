STRATEGY long_limit_sizing_pct_equity_ticks_paper VERSION 1
-- SIZING 5 PCT OF EQUITY on a LIMIT AT 99.80 sizes at the limit price: 500 / 99.80 = 5.01 lots
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 5 PCT OF EQUITY ORDER_TYPE = LIMIT AT 99.80 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 1.00 }
