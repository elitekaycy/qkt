STRATEGY long_market_sizing_usd_gap_open_ticks_paper VERSION 1
-- SIZING 1000 USD sizes at the signal close 100.50 (9.95 lots) and fills on the next tick at 101.00
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 1000 USD BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 }
