STRATEGY long_market_stackat_tier_abandoned_after_within_ticks_paper VERSION 1
-- MFE reaches the threshold 75 s after the primary fill, past WITHIN 1m: the tier is abandoned
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 }
        STACK_AT MFE >= 0.50 WITHIN 1m SIZING 0.05 BRACKET { STOP LOSS BY 0.40, TAKE PROFIT BY 0.60 }
