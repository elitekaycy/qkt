STRATEGY short_market_stackat_mfe_tier_stop_ticks_paper VERSION 1
-- a SELL primary's MFE tier fires on the mark falling to 100.10; its leg stops out alone, the primary takes its target
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN SELL syn SIZING 0.1 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 }
        STACK_AT MFE >= 0.40 WITHIN 5m SIZING 0.05 BRACKET { STOP LOSS BY 0.30, TAKE PROFIT BY 0.80 }
