STRATEGY long_market_oto_entry_is_signal_estimate_netting_ticks_mt5 VERSION 1
-- for a MARKET parent `entry` is the signal-time estimate 100.50, not the 100.52 fill: the child limit is 100.00
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 ON_FILL { BUY syn SIZING 0.1 ORDER_TYPE = LIMIT AT entry - 0.50 }
    WHEN syn.close = 100.80 AND POSITION.syn > 0
    THEN CLOSE syn
