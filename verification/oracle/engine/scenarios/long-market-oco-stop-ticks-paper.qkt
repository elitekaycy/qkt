STRATEGY long_market_oco_stop_ticks_paper VERSION 1
-- OCO { STOP AT, LIMIT AT } protects a long like a bracket; the stop fills and the limit is cancelled
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 OCO { STOP AT 99.50, LIMIT AT 102.50 }
