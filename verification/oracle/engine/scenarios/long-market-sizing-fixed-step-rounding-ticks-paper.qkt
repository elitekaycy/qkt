STRATEGY long_market_sizing_fixed_step_rounding_ticks_paper VERSION 1
-- SIZING 0.125 rounds down to the 0.01 step: 0.12 lots
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.125 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 }
