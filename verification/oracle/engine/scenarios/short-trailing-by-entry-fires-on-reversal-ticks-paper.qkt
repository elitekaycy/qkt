STRATEGY short_trailing_by_entry_fires_on_reversal_ticks_paper VERSION 1
-- SELL TRAILING BY 0.50 ratchets its high-water mark to 101.10 and sells at market when the mark falls 0.51
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN SELL syn SIZING 0.1 ORDER_TYPE = TRAILING BY 0.50
    WHEN syn.close = 100.30 AND POSITION.syn < 0
    THEN CLOSE syn
