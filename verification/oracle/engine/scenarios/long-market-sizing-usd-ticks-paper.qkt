STRATEGY long_market_sizing_usd_ticks_paper VERSION 1
-- SIZING 1000 USD at 100.50 with contractSize 10 is 0.995 lots, quantized to 0.99
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 1000 USD BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 2.00 }
