STRATEGY short_limit_entry_gap_bars_synthetic_paper VERSION 1
-- a pending sell limit the next bar opens beyond fills at that open on the synthetic path
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN SELL syn SIZING 0.1 ORDER_TYPE = LIMIT AT 101.20 BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 1.00 }
