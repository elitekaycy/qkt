STRATEGY short_market_stack_below_pyramid_down_targets_ticks_paper VERSION 1
-- a SELL STACK BELOW adds as price falls (sell stops at 100.00, 99.50); each layer takes its own target
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN SELL syn SIZING 0.1 STACK 3 SPACING 0.50 BELOW BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 1.50 }
