STRATEGY long_market_stack_above_layers_own_stops_ticks_paper VERSION 1
-- STACK 3 SPACING 0.50 ABOVE: rungs at 101.00 and 101.50 off the seed fill, each layer stopped by its own bracket
SYMBOLS
    syn = BACKTEST:SYN EVERY 1m
RULES
    WHEN syn.close = 100.50 AND POSITION.syn = 0
    THEN BUY syn SIZING 0.1 STACK 3 SPACING 0.50 ABOVE BRACKET { STOP_LOSS BY 1.00, TAKE_PROFIT BY 3.00 }
