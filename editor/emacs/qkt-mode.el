;;; qkt-mode.el --- Major mode for qkt strategy files -*- lexical-binding: t -*-

;; Generated by `qkt editor grammar --format emacs'; edit src/main/kotlin/com/qkt/editor/
;; and regenerate rather than editing this file.
;; Highlighting, comments and indentation for .qkt files, plus completion, hover and live
;; diagnostics from `qkt lsp' through eglot (built into Emacs 29).

;;; Code:

(defgroup qkt nil "qkt strategy files." :group 'languages)

(defcustom qkt-enable-lsp t
  "Start `qkt lsp' through eglot when a .qkt file opens and qkt is on `exec-path'."
  :type 'boolean)

(defcustom qkt-lsp-jvm-options "-Xms16m -Xmx256m -Xss512k -XX:TieredStopAtLevel=1 -XX:CICompilerCount=1 -XX:ParallelGCThreads=1"
  "JVM options for the language server, passed as JAVA_TOOL_OPTIONS."
  :type 'string)

(defvar qkt-mode-syntax-table
  (let ((st (make-syntax-table)))
    (modify-syntax-entry ?_ "w" st)
    (modify-syntax-entry ?- ". 12b" st)
    (modify-syntax-entry ?# "< b" st)
    (modify-syntax-entry ?\n "> b" st)
    (modify-syntax-entry ?/ ". 14" st)
    (modify-syntax-entry ?* ". 23" st)
    (modify-syntax-entry ?' "\"" st)
    st)
  "Syntax table for `qkt-mode': -- and # line comments, /* */ block comments.")

(defconst qkt-font-lock-keywords
  (list
   ;; A member after a dot first, so `gold.close' is a field, as the parser reads it.
   '("\\.\\([A-Za-z_][A-Za-z0-9_]*\\)" 1 font-lock-variable-name-face)
   '("\\_<\\([A-Za-z_][A-Za-z0-9_]*\\):[A-Za-z0-9_]" 1 font-lock-type-face)
   (cons (regexp-opt '("BASKET" "DEFAULTS" "IMPORT" "LET" "PARAM" "PORTFOLIO" "REGIMES" "RULES" "SCHEDULE" "SEQUENCE" "SERIES" "STRATEGY" "SYMBOLS" "SYNCHRONIZE" "VERSION") 'symbols) 'font-lock-preprocessor-face)
   (cons (regexp-opt '("CASE" "DO" "EACH" "ELSE" "END" "EVERY" "FOR" "IN" "SINCE" "THEN" "WHEN") 'symbols) 'font-lock-keyword-face)
   (cons (regexp-opt '("BUY" "CANCEL" "CANCEL_ALL" "CLOSE" "CLOSE_ALL" "DEBUG" "ERROR" "FLATTEN" "LOG" "RESIZE" "SELL" "WARN") 'symbols) 'font-lock-keyword-face)
   (cons (regexp-opt '("AT" "BY" "DAY" "FLOOR" "FOK" "GTC" "GTD" "IOC" "LIMIT" "MARKET" "ORDER_TYPE" "PCT" "STEP" "STOP" "STOP_LOSS" "TAKE_PROFIT" "TIF" "TIGHTEN" "TO" "TRAILING" "UNTIL") 'symbols) 'font-lock-keyword-face)
   (cons (regexp-opt '("BALANCE" "EQUITY" "MIN_STEP" "OF" "RISK" "SIZING" "USD") 'symbols) 'font-lock-keyword-face)
   (cons (regexp-opt '("AGAINST" "ARM" "BRACKET" "CLOSE_BEYOND" "CONFIRM" "ENTER" "EXPIRE" "FROM" "LATCH" "LOSS" "OCO" "OCO_ENTRY" "OFFSET" "ON" "PROFIT" "RETEST_HOLD" "RETRACE" "RR" "TAKE" "TIME_IN_BREACH" "WITH") 'symbols) 'font-lock-keyword-face)
   (cons (regexp-opt '("AFTER" "MAE" "MFE" "RECOVER" "SPACING" "STACK" "STACK_AT" "STAGE" "TIMES" "WITHIN") 'symbols) 'font-lock-keyword-face)
   (cons (regexp-opt '("ALLOCATE" "AS" "CAPITAL" "CASH" "DEFAULT" "EQUAL_WEIGHT" "HOLD" "METHOD" "NAME" "OVERRIDE" "REBALANCE" "RUN" "STATE" "WEIGHT") 'symbols) 'font-lock-keyword-face)
   (cons (regexp-opt '("BARS" "BROKER" "CHICAGO" "HOUR" "LONDON" "NY" "SYDNEY" "TOKYO" "UTC" "WARMUP" "WEEKDAY") 'symbols) 'font-lock-keyword-face)
   (cons (regexp-opt '("ON_CLOSE" "ON_FILL" "ON_STOP" "ON_TP") 'symbols) 'font-lock-keyword-face)
   (cons (regexp-opt '("ACCOUNT" "COOLDOWN" "ENTRY_QTY" "EXIT" "NOW" "OPEN_ORDERS" "POSITION" "POSITION_AVG_PRICE" "STREAK" "SYMBOL" "TRADES") 'symbols) 'font-lock-builtin-face)
   (cons (regexp-opt '("ABOVE" "AND" "BELOW" "BETWEEN" "CROSSES" "IS" "NOT" "NULL" "OR") 'symbols) 'font-lock-keyword-face)
   (cons (regexp-opt '("MAX" "MEAN" "MIN" "OPEN" "SUM") 'symbols) 'font-lock-builtin-face)
   (cons (regexp-opt '("FALSE" "TRUE") 'symbols) 'font-lock-constant-face)
   (list (concat (regexp-opt '("ADX" "ANCHORED_RETURN" "ATR" "BETA" "BOLLINGER_LOWER" "BOLLINGER_MIDDLE" "BOLLINGER_UPPER" "CCI" "CONFIRM_RATIO" "CORRELATION" "DEMA" "EMA" "ER" "FAILED_BREAK_HIGH" "FAILED_BREAK_LOW" "GAP_FILL_FRACTION" "HIGHEST" "HMA" "IB_DEFENDED_HIGH" "IB_DEFENDED_LOW" "KELTNER_LOWER" "KELTNER_MIDDLE" "KELTNER_UPPER" "LAG" "LOWEST" "MACD" "MACD_HIST" "MACD_SIGNAL" "MINUS_DI" "OBV" "PERCENTILE_RANK" "PIVOT_P" "PIVOT_R1" "PIVOT_S1" "PLUS_DI" "REGRESSION_SLOPE" "REOPEN_GAP" "REOPEN_GAP_ORIGIN" "RESID" "RSI" "RUNLENGTH" "RUNLENGTH_WHERE" "SEASONAL_RANGE" "SEASONAL_RANGE_STDEV" "SESSION_MOMENTUM" "SESSION_RANGE_HIGH" "SESSION_RANGE_LOW" "SKEW" "SMA" "STDDEV" "STOCH_D" "STOCH_K" "TEMA" "VARIANCE" "VARIANCE_RATIO" "VWAP" "VWAP_SESSION" "VWAP_SESSION_STDEV" "WILLIAMS_R" "WMA" "ZSCORE" "ABS" "AVG" "CALENDAR_WINDOW" "CEIL" "COUNT" "EXP" "FLOOR" "LAST_TRADING_DAY_OF_MONTH" "LOG" "MAX" "MEAN" "MIN" "MOD" "NORMALIZE" "POW" "RANK_OF" "ROUND" "ROUND_TO" "SESSION_WINDOW" "SOFTMAX" "SQRT" "SUM") 'symbols) "\\s-*(") 1 'font-lock-builtin-face)
   (cons (regexp-opt '("BPS" "FIVE_PERCENT" "HALF_PERCENT" "ONE_PERCENT" "QUARTER_PERCENT" "TEN_PERCENT" "THREE_PERCENT" "TWO_PERCENT") 'symbols) 'font-lock-constant-face)
   '("\\_<\\([A-Za-z_][A-Za-z0-9_]*\\)\\s-*(" 1 font-lock-function-name-face)
   '("\\_<[0-9]+\\(?:\\.[0-9]+\\)?\\(?:[eE][+-]?[0-9]+\\)?[smhd]?\\_>" . font-lock-constant-face))
  "Highlighting for `qkt-mode', from the lexer's keyword table and the registries.")

(defun qkt--lsp-contact (&optional _interactive)
  "The eglot command for `qkt lsp', in a small JVM."
  (if (memq system-type '(windows-nt ms-dos))
      '("qkt" "lsp")
    (list "env" (concat "JAVA_TOOL_OPTIONS=" (or (getenv "JAVA_TOOL_OPTIONS") "") " " qkt-lsp-jvm-options)
          "qkt" "lsp")))

(defvar eglot-server-programs)
(declare-function eglot-ensure "eglot")

(with-eval-after-load 'eglot
  (add-to-list 'eglot-server-programs '(qkt-mode . qkt--lsp-contact)))

;;;###autoload
(define-derived-mode qkt-mode prog-mode "qkt"
  "Major mode for qkt strategy files."
  :syntax-table qkt-mode-syntax-table
  (setq-local font-lock-defaults '(qkt-font-lock-keywords nil t))
  (setq-local comment-start "-- ")
  (setq-local comment-end "")
  (setq-local comment-start-skip "\\(?:--\\|#\\)+\\s-*")
  (setq-local indent-tabs-mode nil)
  (when (and qkt-enable-lsp (executable-find "qkt") (require 'eglot nil t))
    (eglot-ensure)))

(defun qkt--reclaim-from-haskell ()
  "Move a .qkt buffer from `haskell-mode' to `qkt-mode'."
  (when (and buffer-file-name (string-match-p "\\.qkt\\'" buffer-file-name))
    (qkt-mode)))

;;;###autoload
(add-to-list 'auto-mode-alist '("\\.qkt\\'" . qkt-mode))
(add-hook 'haskell-mode-hook #'qkt--reclaim-from-haskell)

(provide 'qkt-mode)
;;; qkt-mode.el ends here
