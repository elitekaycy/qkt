# qkt project config. Copy to qkt.config.yaml and adjust.
#
# - `${VAR}` values are substituted from environment variables at load time.
# - Broker entries with `type: mt5` route through the MT5 broker (Phase 17/18).
# - The neutral `mt5` profile below requires the broker's server clock explicitly.
# - Built-in profiles remain available when broker-specific defaults are desired.
# - For multi-account same-broker setups, use `extends:` with a distinct name.
#
# Run `qkt brokers list` to see the resolved profile set.

source: tv                            # default tick source for live mode
data_root: ./data                     # historical-data store
starting_balance: 10000               # default starting balance for backtest reports
log_level: info

# Optional Bybit account, reached through the qkt-venue-gateway running its Bybit adapter
# (https://github.com/elitekaycy/qkt-venue-gateway/blob/main/adapter-bybit/README.md).
# The entry name is the prefix strategies use: bybit_linear serves BYBIT_LINEAR: streams.
# bybit_linear:
#   type: gateway
#   gateway_url: http://127.0.0.1:8444
#   api_key: env:BYBIT_TRADER_TOKEN
#   expected_adapter: bybit
#   expected_account_login: "<the account_login the gateway reports>"
#   expected_trade_mode: demo

brokers:
  mt5:
    type: mt5
    gateway_url: ${QKT_BROKER_GATEWAY_URL:-http://mt5-gateway:5001}
    api_key: ${QKT_BROKER_API_KEY}
    server_time_zone: ${QKT_BROKER_SERVER_TIME_ZONE}
    symbol_suffix: ${QKT_BROKER_SYMBOL_SUFFIX:-}
    magic: ${QKT_BROKER_MAGIC:-10001}

  # Example: a second account on a separate gateway/login.
  # mt5-personal:
  #   type: mt5
  #   extends: mt5
  #   gateway_url: http://mt5-gateway-2:5001
  #   magic: 10005

  # Example: a totally new MT5 broker.
  # icmarkets:
  #   type: mt5
  #   gateway_url: http://localhost:5002
  #   symbol_suffix: ".raw"
  #   server_time_zone: new_york_close
  #   magic: 10002
