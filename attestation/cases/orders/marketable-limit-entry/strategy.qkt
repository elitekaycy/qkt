STRATEGY atto_mkt_limit VERSION 1

SYMBOLS
    btc = EXNESS:BTCUSD EVERY 1m WARMUP 3 BARS

RULES
    -- A buy limit 200 above the close is through the market when it arrives: the venue refuses it
    -- (BUY_LIMIT must be below the ask), and the replay must refuse it too. The market order beside it
    -- gives the case a fill to replay, so the two must also agree that it is the only fill.
    WHEN btc.close > 0 AND TRADES.today = 0 AND OPEN_ORDERS.btc = 0 AND POSITION.btc = 0
    THEN BUY btc SIZING 0.01 ORDER_TYPE = LIMIT AT btc.close + 200 TIF GTD UNTIL NOW + 2m
       ; BUY btc SIZING 0.01 BRACKET { STOP LOSS BY 3000, TAKE PROFIT BY 6000 }

    WHEN POSITION.btc != 0 AND POSITION.btc.holding_duration >= 50
    THEN CLOSE btc
