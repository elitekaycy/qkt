STRATEGY atto_limit_gtd VERSION 1

SYMBOLS
    btc = EXNESS:BTCUSD EVERY 1m WARMUP 3 BARS

RULES
    -- Rests 3,000 below the market (inside the 5% price collar) for two minutes: it must reach the venue, stay unfilled, expire.
    WHEN btc.close > 0 AND TRADES.today = 0 AND OPEN_ORDERS.btc = 0 AND POSITION.btc = 0
    THEN BUY btc SIZING 0.01 ORDER_TYPE = LIMIT AT btc.close - 3000 TIF GTD UNTIL NOW + 2m
       ; SELL btc SIZING 0.01 BRACKET { STOP LOSS BY 3000, TAKE PROFIT BY 6000 }

    -- Held past the limit's two minutes: CLOSE clears pending orders on the stream, and the
    -- point of this case is that the venue expires the limit by itself first.
    WHEN POSITION.btc != 0 AND POSITION.btc.holding_duration >= 170
    THEN CLOSE btc
