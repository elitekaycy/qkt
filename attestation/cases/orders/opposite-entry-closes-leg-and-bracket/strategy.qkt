STRATEGY atto_opp_close VERSION 1

SYMBOLS
    btc = EXNESS:BTCUSD EVERY 1m WARMUP 3 BARS

RULES
    WHEN btc.close > 0 AND POSITION.btc = 0 AND OPEN_ORDERS.btc = 0 AND TRADES.today = 0
    THEN BUY btc SIZING 0.01 BRACKET { STOP LOSS BY 3000, TAKE PROFIT BY 6000 }

    -- A plain opposite SELL, not CLOSE: on a hedging account it is routed as a close of the long leg,
    -- and the leg's own stop and target must go with it.
    WHEN POSITION.btc > 0 AND POSITION.btc.holding_duration >= 50
    THEN SELL btc SIZING 0.01
