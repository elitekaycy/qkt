STRATEGY atto_drill_kill VERSION 1

SYMBOLS
    eth = DERIBIT:ETH_USDC_PERPETUAL EVERY 1m WARMUP 3 BARS

RULES
    WHEN eth.close > 0 AND POSITION.eth = 0 AND OPEN_ORDERS.eth = 0 AND TRADES.today = 0
    THEN BUY eth SIZING 0.0001 BRACKET { STOP LOSS BY 90, TAKE PROFIT BY 180 }

    WHEN POSITION.eth != 0 AND POSITION.eth.holding_duration >= 300
    THEN CLOSE eth
