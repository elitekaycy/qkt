STRATEGY atto_drill_flat VERSION 1

SYMBOLS
    btc = DERIBIT:BTC_USDC_PERPETUAL EVERY 1m WARMUP 3 BARS

RULES
    WHEN btc.close > 0 AND POSITION.btc = 0 AND OPEN_ORDERS.btc = 0 AND TRADES.today < 2
    THEN BUY btc SIZING 0.0001 BRACKET { STOP LOSS BY 3000, TAKE PROFIT BY 6000 }

    WHEN POSITION.btc != 0 AND POSITION.btc.holding_duration >= 60
    THEN CLOSE btc
