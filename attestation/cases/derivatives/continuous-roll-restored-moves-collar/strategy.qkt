STRATEGY atto_roll_restored VERSION 1

SYMBOLS
    fut = DERIBIT:ETH_USDC@front EVERY 1m WARMUP 3 BARS

RULES
    -- The daemon starts 300 s before the roll; held across the roll and the restart inside it, then closed on the new contract.
    WHEN fut.close > 0 AND POSITION.fut = 0 AND OPEN_ORDERS.fut = 0 AND TRADES.today = 0
    THEN BUY fut SIZING 0.001

    WHEN POSITION.fut != 0 AND POSITION.fut.holding_duration >= 420
    THEN CLOSE fut
