STRATEGY atto_roll VERSION 1

SYMBOLS
    btc = DERIBIT:BTC_USDC@front EVERY 1m WARMUP 3 BARS

RULES
    -- Enters inside the three minutes before the generated roll, holds across it, then closes on the new contract.
    WHEN btc.close > 0 AND POSITION.btc = 0 AND OPEN_ORDERS.btc = 0 AND TRADES.today = 0
    THEN BUY btc SIZING 0.001

    WHEN POSITION.btc != 0 AND POSITION.btc.holding_duration >= 300
    THEN CLOSE btc
