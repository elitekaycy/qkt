STRATEGY atto_spread VERSION 1

SYMBOLS
    chain = OPTIONS:DERIBIT.BTC_USDC EVERY 1m,
    iv = CHAIN:DERIBIT.BTC_USDC.atm_iv.30d EVERY 1m

RULES
    WHEN iv.close > 0 AND POSITION.ps = 0 AND TRADES.today = 0
    THEN OPEN ps = OPTIONS ON DERIBIT:BTC_USDC {
        SELL PUT DELTA 0.25 DTE 20 TO 60,
        BUY PUT DELTA 0.10 SAME EXPIRY
    } SIZING 0.01

    WHEN POSITION.ps != 0 AND iv.close > 0
    THEN CLOSE ps
