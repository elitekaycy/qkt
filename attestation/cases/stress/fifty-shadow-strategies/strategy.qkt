STRATEGY atto_fan VERSION 1

SYMBOLS
    eur = EXNESS:EURUSD EVERY 1m WARMUP 30 BARS,
    gold = EXNESS:XAUUSD EVERY 1m WARMUP 30 BARS,
    btc = EXNESS:BTCUSD EVERY 1m WARMUP 30 BARS,
    btc5 = EXNESS:BTCUSD EVERY 5m WARMUP 20 BARS

-- The copies start a minute or two apart, each seeded from history up to its own start. A bar read from MT5
-- history is not the bar the live ticks build (one spread per bar), so a statistic over the window differs
-- between copies until the seeded bars leave it. A bar's close is its last tick: every copy that built the bar
-- live prints the same close, and a dropped or reordered tick prints a different one.
RULES
    -- One symbol per rule: each line depends on one feed only, so fifty copies must print the same text.
    WHEN eur.close > lag(eur.close, 1)
    THEN LOG "atto-fan eur up close={c}" c=eur.close
    WHEN eur.close <= lag(eur.close, 1)
    THEN LOG "atto-fan eur down close={c}" c=eur.close

    WHEN gold.close > lag(gold.close, 1)
    THEN LOG "atto-fan gold up close={c}" c=gold.close
    WHEN gold.close <= lag(gold.close, 1)
    THEN LOG "atto-fan gold down close={c}" c=gold.close

    WHEN btc5.close > 0 AND btc.close > lag(btc.close, 1)
    THEN LOG "atto-fan btc up close={c}" c=btc.close
    WHEN btc5.close > 0 AND btc.close <= lag(btc.close, 1)
    THEN LOG "atto-fan btc down close={c}" c=btc.close
