STRATEGY atto_down_close VERSION 1

SYMBOLS
    btc = EXNESS:BTCUSD EVERY 1m WARMUP 3 BARS

RULES
    -- Enters whenever flat: after the venue closes the position behind the engine's back,
    -- the only thing standing between this rule and a second entry is the restored rule edge.
    WHEN btc.close > 0 AND POSITION.btc = 0 AND OPEN_ORDERS.btc = 0
    THEN BUY btc SIZING 0.01 BRACKET { STOP LOSS BY 4000, TAKE PROFIT BY 8000 }
