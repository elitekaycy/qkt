STRATEGY atto_kill9 VERSION 1

SYMBOLS
    btc = EXNESS:BTCUSD EVERY 1m WARMUP 3 BARS

RULES
    -- One entry, held long enough to be restarted over, then closed by the strategy's own rule.
    WHEN btc.close > 0 AND POSITION.btc = 0 AND OPEN_ORDERS.btc = 0 AND TRADES.today = 0
    THEN BUY btc SIZING 0.01 BRACKET { STOP LOSS BY 4000, TAKE PROFIT BY 8000 }

    WHEN POSITION.btc != 0 AND POSITION.btc.holding_duration >= 150
    THEN CLOSE btc
