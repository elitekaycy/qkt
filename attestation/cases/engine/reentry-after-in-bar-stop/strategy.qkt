STRATEGY atto_reentry VERSION 1

SYMBOLS
    btc = EXNESS:BTCUSD EVERY 1m WARMUP 3 BARS

RULES
    -- The signal never goes false. The bracket is far away: the exit in this case is the venue's,
    -- made by the runner seconds after the fill.
    WHEN btc.close > 0 AND POSITION.btc = 0 AND OPEN_ORDERS.btc = 0
    THEN BUY btc SIZING 0.01 BRACKET { STOP LOSS BY 3000, TAKE PROFIT BY 6000 }
