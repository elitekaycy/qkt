STRATEGY atto_cap_a VERSION 1

SYMBOLS
    btc = EXNESS:BTCUSD EVERY 1m WARMUP 3 BARS

RULES
    -- 0.01 BTC is roughly 850 of exposure. Both children want it on the same bar close; the book
    -- allows 1,200 gross, so exactly one of them may have it.
    WHEN btc.close > 0 AND POSITION.btc = 0 AND OPEN_ORDERS.btc = 0 AND TRADES.today = 0
    THEN BUY btc SIZING 0.01 BRACKET { STOP LOSS BY 3000, TAKE PROFIT BY 6000 }

    WHEN POSITION.btc != 0 AND POSITION.btc.holding_duration >= 100
    THEN CLOSE btc
