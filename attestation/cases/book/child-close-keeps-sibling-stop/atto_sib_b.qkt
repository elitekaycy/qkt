STRATEGY atto_sib_b VERSION 1

SYMBOLS
    btc = EXNESS:BTCUSD EVERY 1m WARMUP 3 BARS

RULES
    -- The sibling that closes early: its CLOSE may clear its own orders on the symbol, never A's.
    WHEN btc.close > 0 AND POSITION.btc = 0 AND OPEN_ORDERS.btc = 0 AND TRADES.today = 0
    THEN BUY btc SIZING 0.01 BRACKET { STOP LOSS BY 3500, TAKE PROFIT BY 7000 }

    WHEN POSITION.btc != 0 AND POSITION.btc.holding_duration >= 50
    THEN CLOSE btc
