STRATEGY atto_late_b VERSION 1

SYMBOLS
    btc = EXNESS:BTCUSD EVERY 1m WARMUP 3 BARS

RULES
    -- Both children enter on the same bar close; the first fill breaches the book, the other is still in flight.
    WHEN btc.close > 0 AND POSITION.btc = 0 AND OPEN_ORDERS.btc = 0 AND TRADES.today = 0
    THEN BUY btc SIZING 0.5 PCT RISK OF BOOK BRACKET { STOP LOSS BY 500, TAKE PROFIT BY 1000 }

    WHEN POSITION.btc != 0 AND POSITION.btc.holding_duration >= 3000
    -- Far beyond the case: only the book may close it.
    THEN CLOSE btc
