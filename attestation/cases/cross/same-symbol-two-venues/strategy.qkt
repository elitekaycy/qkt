STRATEGY atto_xsame VERSION 1

SYMBOLS
    cfd = EXNESS:BTCUSD EVERY 1m WARMUP 3 BARS
    paper = PAPER:BTC_USDC_PERPETUAL EVERY 1m WARMUP 3 BARS
    deribit = DERIBIT:BTC_USDC_PERPETUAL EVERY 1m WARMUP 3 BARS

RULES
    WHEN cfd.close > 0 AND paper.close > 0 AND deribit.close > 0
     AND POSITION.cfd = 0 AND POSITION.paper = 0 AND POSITION.deribit = 0
     AND OPEN_ORDERS.cfd = 0 AND OPEN_ORDERS.paper = 0 AND OPEN_ORDERS.deribit = 0 AND TRADES.today = 0
    THEN BUY cfd SIZING 0.01; SELL paper SIZING 0.001; BUY deribit SIZING 0.001

    WHEN POSITION.cfd != 0 AND POSITION.cfd.holding_duration >= 50
    THEN CLOSE cfd

    WHEN POSITION.paper != 0 AND POSITION.paper.holding_duration >= 50
    THEN CLOSE paper

    WHEN POSITION.deribit != 0 AND POSITION.deribit.holding_duration >= 50
    THEN CLOSE deribit
