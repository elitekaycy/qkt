STRATEGY atto_stk_sizing VERSION 1

SYMBOLS
    nvda = EXNESS:NVDA EVERY 1m WARMUP 3 BARS,
    msft = EXNESS:MSFT EVERY 1m WARMUP 3 BARS

RULES
    -- $500 of NVDA at about $200-$250 a share is 2 shares: 500 / (price x 100) = 0.02 lot. $5 at risk with a $2.50
    -- stop is 2 shares of MSFT: 5 / (2.50 x 100) = 0.02 lot, whatever MSFT trades at. One rule sends both, so a
    -- strategy-wide TRADES.today cannot let one symbol's entry block the other's on the same bar.
    WHEN nvda.close > 0 AND msft.close > 0 AND POSITION.nvda = 0 AND POSITION.msft = 0 AND TRADES.today = 0
    THEN BUY nvda SIZING 500 USD ; BUY msft SIZING RISK $ 5 BRACKET { STOP LOSS BY 2.5, TAKE PROFIT BY 5 }

    WHEN POSITION.nvda != 0 AND POSITION.nvda.holding_duration >= 50
    THEN CLOSE nvda

    WHEN POSITION.msft != 0 AND POSITION.msft.holding_duration >= 50
    THEN CLOSE msft
