source: local
data_root: /data
starting_balance: ${QKT_STARTING_BALANCE:-100000}

runtime:
  mode: dev

state:
  enabled: false

brokers: {}

# Repeatable project-local backtests: `qkt backtest` runs the default, `qkt backtest <run>`
# runs a named one (flags always win). Uncomment and adapt.
# backtest:
#   strategy: portfolios/main.qkt
#   from: 2025-09-01
#   to: 2025-10-01
#
# report:
#   dir: runs/

book_risk:
  capital: ${QKT_STARTING_BALANCE:-100000}
  limits:
    max_gross_exposure: "300000"
    max_net_exposure: "150000"
    max_symbol_concentration: "0.60"
  allocation:
    method: FIXED
    max_leverage: "1"
