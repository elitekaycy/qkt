# qkt daemon config. Defaults assume the docker-compose.yml that ships with this
# template. Edit broker.exness.* to point at your live MT5 account; or rename the
# profile and point a different DSL strategy at it.
#
# `source` controls only the fallback for symbols that do not match a broker
# route. EXNESS:* streams still use brokers.exness for MT5 market data and
# execution. Keep this local for MT5-first production deploys so an unused
# TradingView WebSocket cannot hide routing mistakes or spam reconnect logs.
source: local

state:
  enabled: true

runtime:
  mode: production
  waivers:
    alerts:
      reason: ${QKT_ALERTS_WAIVER_REASON:-}

risk:
  max_daily_loss: ${QKT_MAX_DAILY_LOSS}
  max_order_qty: ${QKT_MAX_ORDER_QTY}
  max_order_notional: ${QKT_MAX_ORDER_NOTIONAL}
  price_collar_pct: ${QKT_PRICE_COLLAR_PCT}

brokers:
  exness:
    type: mt5
    extends: exness
    gateway_url: ${QKT_EXNESS_URL:-http://mt5-gateway:5001}
    api_key: ${QKT_BROKER_EXNESS_API_KEY}
    magic: ${QKT_EXNESS_MAGIC:-10001}

notify:
  telegram:
    enabled: ${TELEGRAM_ENABLED}
    bot_token: ${TELEGRAM_BOT_TOKEN}
    chat_id: ${TELEGRAM_CHAT_ID}
    events:
      - daemon_started
      - strategy_error
      - halted
      - resumed

insights:
  enabled: ${QKT_INSIGHTS_ENABLED}
  url: http://qkt-insights:8420/ingest
  instance_id: ${QKT_INSIGHTS_INSTANCE_ID}
  token: ${QKT_INSIGHTS_INGEST_TOKEN}
  events: [trade, order, signal, risk, position, state, deal, lifecycle, log]
  journal_enabled: true
  journal_dir: /var/lib/qkt/insights-journal
  state_poll_ms: 10000
  deal_backfill_days: 30
