# qkt daemon config. Defaults assume the docker-compose.yml that ships with this
# template. Edit broker.exness.* to point at your live MT5 account; or rename the
# profile and point a different DSL strategy at it.

state:
  enabled: true

runtime:
  mode: production

risk:
  max_daily_loss: ${QKT_MAX_DAILY_LOSS}
  max_order_qty: ${QKT_MAX_ORDER_QTY}
  max_order_notional: ${QKT_MAX_ORDER_NOTIONAL}
  price_collar_pct: ${QKT_PRICE_COLLAR_PCT}

brokers:
  exness:
    type: mt5
    extends: exness
    gateway_url: ${QKT_EXNESS_URL:-http://mt5-gateway:5001}
    api_key: ${QKT_BROKER_EXNESS_API_KEY}
    magic: ${QKT_EXNESS_MAGIC:-10001}

notify:
  telegram:
    enabled: ${TELEGRAM_ENABLED}
    bot_token: ${TELEGRAM_BOT_TOKEN}
    chat_id: ${TELEGRAM_CHAT_ID}
    events:
      - daemon_started
      - strategy_error
      - halted
      - resumed
