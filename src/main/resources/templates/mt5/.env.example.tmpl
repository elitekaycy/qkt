# qkt MT5 deployment env - copy to .env and edit before `make up`.

# Required: runtime images.
# QKT_IMAGE_TAG is explicit so the stack never silently upgrades/downgrades.
QKT_IMAGE_TAG=v{{QKT_VERSION}}
MT5_GATEWAY_IMAGE=elitekaycy/mt5-gateway-api:0.3.5

# Required: headless MT5 login. The gateway logs into this account on boot.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Required: bearer token used by QKT when calling the MT5 gateway.
MT5_API_KEY=replace-with-a-long-random-value

# Required before real capital: explicit production risk controls.
# Account equity baseline used by drawdown calculations. Match this to the
# broker account balance at deploy time; a mismatch makes halt logic unsafe.
QKT_STARTING_BALANCE=50000
QKT_MAX_DAILY_LOSS=100
QKT_MAX_ORDER_QTY=1
QKT_MAX_ORDER_NOTIONAL=50000
QKT_PRICE_COLLAR_PCT=5
# FTMO-style box: 10% total / 5% daily loss from the starting balance.
QKT_MAX_DRAWDOWN_PCT=10
QKT_MAX_DAILY_DRAWDOWN_PCT=5
# Safe-rollout ramp: for this many hours after deploy, entries above 0.01 lots
# reject. Set 0 to trade full size immediately; keep 24 for new real capital.
QKT_MEASURED_USAGE_HOURS=24

# Required: broker-specific MT5 behavior. The server clock accepts UTC,
# new_york_close, an IANA zone, or a fixed offset such as +02:00.
QKT_BROKER_SERVER_TIME_ZONE=
QKT_BROKER_SYMBOL_SUFFIX=

# Usually keep defaults.
COMPOSE_PROJECT_NAME=qkt-mt5
QKT_BIND_HOST=127.0.0.1
MT5_API_HOST_PORT=5020
MT5_VNC_HOST_PORT=3020
QKT_BROKER_MAGIC=10001
MT5_ENABLE_ALGO_TRADING=1
MT5_RESOLVER_URL=https://mt5.mtapi.io,http://mt5-resolver:80
MT5_LOG_LEVEL=INFO

# Diagnostic fallback only. The normal path is headless MT5 login above. VNC is
# bound to 127.0.0.1 by compose; use an SSH tunnel if you need to inspect MT5.
MT5_VNC_USER=admin
MT5_VNC_PASSWORD=changeme

# Optional Telegram alerts.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional explicit production waiver. Prefer enabling Telegram alerts instead.
QKT_ALERTS_WAIVER_REASON=

# Optional qkt-insights dashboard and durable event egress.
QKT_INSIGHTS_ENABLED=false
COMPOSE_PROFILES=
QKT_INSIGHTS_BIND_HOST=127.0.0.1
QKT_INSIGHTS_HOST_PORT=8420
QKT_INSIGHTS_IMAGE=ghcr.io/elitekaycy/qkt-insights:latest
QKT_INSIGHTS_INSTANCE_ID=qkt-mt5
QKT_INSIGHTS_INGEST_TOKEN=replace-with-a-long-random-value
QKT_INSIGHTS_ADMIN_USERNAME=admin
QKT_INSIGHTS_ADMIN_PASSWORD=replace-with-a-strong-password
QKT_INSIGHTS_SESSION_SECRET=replace-with-a-long-random-value
# Uptime alerts from qkt-insights reuse TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID above. The
# dead-man URL (healthchecks.io, an Uptime Kuma push monitor) is pinged every 30s so an
# outside service pages when this whole box goes dark. Both optional.
QKT_INSIGHTS_ALERT_WEBHOOK_URL=
QKT_INSIGHTS_DEADMAN_URL=
