services:
  init-perms:
    image: alpine:3
    # Pre-create the logs subdir on the host source so the daemon's
    # `Files.createDirectories(/var/lib/qkt/logs)` at startup succeeds inside
    # the single bind mount. See qkt-prod#1 for the failure mode this avoids.
    command: sh -c "mkdir -p /qkt-state/logs && chown -R 911:911 /config && chown -R 999:999 /qkt-state"
    volumes:
      - mt5_config:/config
      - ./state:/qkt-state
    restart: "no"

  mt5-gateway:
    image: ${MT5_GATEWAY_IMAGE:-elitekaycy/mt5-gateway-api:0.3.5}
    restart: unless-stopped
    depends_on:
      init-perms:
        condition: service_completed_successfully
    environment:
      # VNC is diagnostic-only; MT5_LOGIN/PASSWORD/SERVER below are the normal headless path.
      CUSTOM_USER: ${MT5_VNC_USER:-admin}
      PASSWORD: ${MT5_VNC_PASSWORD:-changeme}
      MT5_API_PORT: 5001
      SWAGGER_SCHEME: http
      MT5_RECONNECT_ATTEMPTS: 5
      MT5_RECONNECT_BASE_DELAY: "2.0"
      LOG_LEVEL: ${MT5_LOG_LEVEL:-INFO}
      # Headless broker login. Set MT5_LOGIN/PASSWORD/SERVER in .env.
      MT5_LOGIN: ${MT5_LOGIN:-}
      MT5_PASSWORD: ${MT5_PASSWORD:-}
      MT5_SERVER: ${MT5_SERVER:-}
      MT5_ENABLE_ALGO_TRADING: ${MT5_ENABLE_ALGO_TRADING:-1}
      MT5_RESOLVER_URL: ${MT5_RESOLVER_URL:-https://mt5.mtapi.io}
      API_KEY: ${MT5_API_KEY:?MT5_API_KEY must be set in .env}
    ports:
      # MT5 REST API. Bind to loopback; bearer auth is also enabled.
      - "${QKT_BIND_HOST:-127.0.0.1}:${MT5_API_HOST_PORT:-5020}:5001"
      # VNC web UI for diagnostic/manual fallback only.
      # SSH-tunnel `-L 3020:127.0.0.1:${MT5_VNC_HOST_PORT:-3020} <host>` and open http://127.0.0.1:3020.
      - "${QKT_BIND_HOST:-127.0.0.1}:${MT5_VNC_HOST_PORT:-3020}:3000"
    volumes:
      - mt5_config:/config
    healthcheck:
      test:
        [
          "CMD-SHELL",
          'curl -fsS -H "Authorization: Bearer $$API_KEY" http://localhost:5001/health/ready',
        ]
      interval: 30s
      timeout: 10s
      retries: 30
      start_period: 300s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"

  qkt:
    image: ghcr.io/elitekaycy/qkt:${QKT_IMAGE_TAG:?QKT_IMAGE_TAG must be set in .env}
    restart: unless-stopped
    stop_grace_period: 30s
    depends_on:
      init-perms:
        condition: service_completed_successfully
      mt5-gateway:
        condition: service_healthy
    command: ["--config", "/etc/qkt/qkt.config.yaml", "--control-port", "47000"]
    environment:
      QKT_STATE_DIR: /var/lib/qkt
      QKT_EXNESS_URL: http://mt5-gateway:5001
      QKT_EXNESS_MAGIC: ${QKT_EXNESS_MAGIC:-10001}
      QKT_BROKER_EXNESS_API_KEY: ${MT5_API_KEY}
      TELEGRAM_ENABLED: ${TELEGRAM_ENABLED:-false}
      TELEGRAM_BOT_TOKEN: ${TELEGRAM_BOT_TOKEN:-}
      TELEGRAM_CHAT_ID: ${TELEGRAM_CHAT_ID:-}
      QKT_ALERTS_WAIVER_REASON: ${QKT_ALERTS_WAIVER_REASON:-}
      QKT_MAX_DAILY_LOSS: ${QKT_MAX_DAILY_LOSS:-100}
      QKT_MAX_ORDER_QTY: ${QKT_MAX_ORDER_QTY:-1}
      QKT_MAX_ORDER_NOTIONAL: ${QKT_MAX_ORDER_NOTIONAL:-50000}
      QKT_PRICE_COLLAR_PCT: ${QKT_PRICE_COLLAR_PCT:-5}
      QKT_INSIGHTS_ENABLED: ${QKT_INSIGHTS_ENABLED:-false}
      QKT_INSIGHTS_INSTANCE_ID: ${QKT_INSIGHTS_INSTANCE_ID:-qkt-mt5}
      QKT_INSIGHTS_INGEST_TOKEN: ${QKT_INSIGHTS_INGEST_TOKEN:-}
    volumes:
      - ./strategies:/strategies:ro
      - ./scripts:/deploy-scripts:ro
      - ./qkt.config.yaml:/etc/qkt/qkt.config.yaml:ro
      # Single bind for the daemon's state dir. The daemon writes its `logs/`
      # subdir inside this bind, persisted to `./state/logs/` on host. Avoid
      # nesting a separate `./logs:/var/lib/qkt/logs` mount — Docker handles
      # nested bind mounts unreliably and the inner mount can fail silently.
      - ./state:/var/lib/qkt
    healthcheck:
      test: ["CMD", "/bin/sh", "/deploy-scripts/verify-live.sh"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 60s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"

  qkt-insights:
    image: ${QKT_INSIGHTS_IMAGE:-ghcr.io/elitekaycy/qkt-insights:latest}
    restart: unless-stopped
    command: run
    profiles: ["insights"]
    ports:
      # Dashboard/API. Bind to loopback; use an SSH tunnel for operator access.
      - "${QKT_INSIGHTS_BIND_HOST:-127.0.0.1}:${QKT_INSIGHTS_HOST_PORT:-8420}:8420"
    environment:
      INSIGHTS_DB: /data/insights.db
      INGEST_TOKEN: ${QKT_INSIGHTS_INGEST_TOKEN:-}
      ADMIN_USERNAME: ${QKT_INSIGHTS_ADMIN_USERNAME:-admin}
      ADMIN_PASSWORD: ${QKT_INSIGHTS_ADMIN_PASSWORD:-}
      SESSION_SECRET: ${QKT_INSIGHTS_SESSION_SECRET:-}
    volumes:
      - insights_data:/data
    healthcheck:
      test: ["CMD-SHELL", "node -e \"fetch('http://127.0.0.1:8420/healthz').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))\""]
      interval: 30s
      timeout: 3s
      retries: 5
      start_period: 10s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"

volumes:
  mt5_config:
  insights_data:
