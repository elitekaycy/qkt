-- Production-shaped MT5 example with explicit sizing, protective brackets,
-- a trend filter, and a timed exit. Tune all values before live deployment.

STRATEGY full_strategy VERSION 1

DEFAULTS {
    SIZING = 0.01
}

SYMBOLS
    gold = EXNESS:XAUUSD EVERY 5m WARMUP 100 BARS

RULES
    WHEN ema(gold.close, 9) CROSSES ABOVE ema(gold.close, 21)
     AND gold.close > ema(gold.close, 50)
     AND POSITION.gold = 0
    THEN BUY gold
         BRACKET { STOP LOSS BY 180, TAKE PROFIT BY 300 }

    WHEN POSITION.gold > 0
     AND (
         ema(gold.close, 9) CROSSES BELOW ema(gold.close, 21)
         OR POSITION.gold.holding_duration > 14400
     )
    THEN CLOSE gold
