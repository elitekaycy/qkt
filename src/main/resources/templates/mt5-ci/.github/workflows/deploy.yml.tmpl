name: deploy

on:
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: production-deploy
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: production
    permissions:
      contents: read
    env:
      DEPLOY_HOST: ${{ secrets.DEPLOY_HOST }}
      DEPLOY_USER: ${{ secrets.DEPLOY_USER }}
      DEPLOY_SSH_KEY: ${{ secrets.DEPLOY_SSH_KEY }}
      DEPLOY_KNOWN_HOSTS: ${{ secrets.DEPLOY_KNOWN_HOSTS }}
      DEPLOY_PORT: ${{ vars.DEPLOY_PORT || '22' }}
      DEPLOY_PATH: ${{ vars.DEPLOY_PATH || '/opt/qkt' }}
      MT5_LOGIN: ${{ secrets.MT5_LOGIN }}
      MT5_PASSWORD: ${{ secrets.MT5_PASSWORD }}
      MT5_SERVER: ${{ vars.MT5_SERVER || '' }}
      MT5_API_KEY: ${{ secrets.MT5_API_KEY }}
      MT5_VNC_USER: ${{ vars.MT5_VNC_USER || 'admin' }}
      MT5_VNC_PASSWORD: ${{ secrets.MT5_VNC_PASSWORD || vars.MT5_VNC_PASSWORD || 'changeme' }}
      COMPOSE_PROJECT_NAME: ${{ vars.COMPOSE_PROJECT_NAME || 'qkt-mt5' }}
      QKT_IMAGE_TAG: ${{ vars.QKT_IMAGE_TAG || 'v{{QKT_VERSION}}' }}
      MT5_GATEWAY_IMAGE: ${{ vars.MT5_GATEWAY_IMAGE || 'elitekaycy/mt5-gateway-api:0.3.5' }}
      QKT_BIND_HOST: ${{ vars.QKT_BIND_HOST || '127.0.0.1' }}
      MT5_API_HOST_PORT: ${{ vars.MT5_API_HOST_PORT || '5020' }}
      MT5_VNC_HOST_PORT: ${{ vars.MT5_VNC_HOST_PORT || '3020' }}
      QKT_BROKER_SERVER_TIME_ZONE: ${{ vars.QKT_BROKER_SERVER_TIME_ZONE || '' }}
      QKT_BROKER_SYMBOL_SUFFIX: ${{ vars.QKT_BROKER_SYMBOL_SUFFIX || '' }}
      QKT_BROKER_MAGIC: ${{ vars.QKT_BROKER_MAGIC || '10001' }}
      TELEGRAM_ENABLED: ${{ vars.TELEGRAM_ENABLED || 'false' }}
      TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
      TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
      QKT_ALERTS_WAIVER_REASON: ${{ vars.QKT_ALERTS_WAIVER_REASON || '' }}
      QKT_STARTING_BALANCE: ${{ vars.QKT_STARTING_BALANCE || '50000' }}
      QKT_MAX_DAILY_LOSS: ${{ vars.QKT_MAX_DAILY_LOSS || '100' }}
      QKT_MAX_ORDER_QTY: ${{ vars.QKT_MAX_ORDER_QTY || '1' }}
      QKT_MAX_ORDER_NOTIONAL: ${{ vars.QKT_MAX_ORDER_NOTIONAL || '50000' }}
      QKT_PRICE_COLLAR_PCT: ${{ vars.QKT_PRICE_COLLAR_PCT || '5' }}
      QKT_MAX_DRAWDOWN_PCT: ${{ vars.QKT_MAX_DRAWDOWN_PCT || '10' }}
      QKT_MAX_DAILY_DRAWDOWN_PCT: ${{ vars.QKT_MAX_DAILY_DRAWDOWN_PCT || '5' }}
      QKT_MEASURED_USAGE_HOURS: ${{ vars.QKT_MEASURED_USAGE_HOURS || '24' }}
      QKT_INSIGHTS_ENABLED: ${{ vars.QKT_INSIGHTS_ENABLED || 'false' }}
      QKT_INSIGHTS_BIND_HOST: ${{ vars.QKT_INSIGHTS_BIND_HOST || '127.0.0.1' }}
      QKT_INSIGHTS_HOST_PORT: ${{ vars.QKT_INSIGHTS_HOST_PORT || '8420' }}
      QKT_INSIGHTS_IMAGE: ${{ vars.QKT_INSIGHTS_IMAGE || 'ghcr.io/elitekaycy/qkt-insights:latest' }}
      QKT_INSIGHTS_INSTANCE_ID: ${{ vars.QKT_INSIGHTS_INSTANCE_ID || 'qkt-mt5' }}
      QKT_INSIGHTS_INGEST_TOKEN: ${{ secrets.QKT_INSIGHTS_INGEST_TOKEN }}
      QKT_INSIGHTS_ADMIN_USERNAME: ${{ vars.QKT_INSIGHTS_ADMIN_USERNAME || 'admin' }}
      QKT_INSIGHTS_ADMIN_PASSWORD: ${{ secrets.QKT_INSIGHTS_ADMIN_PASSWORD }}
      QKT_INSIGHTS_SESSION_SECRET: ${{ secrets.QKT_INSIGHTS_SESSION_SECRET }}

    steps:
      - uses: actions/checkout@93cb6efe18208431cddfb8368fd83d5badbf9bfd # v5

      - name: Validate required environment secrets
        shell: bash
        run: |
          set -euo pipefail
          for name in DEPLOY_HOST DEPLOY_USER DEPLOY_SSH_KEY DEPLOY_KNOWN_HOSTS \
            MT5_LOGIN MT5_PASSWORD MT5_SERVER MT5_API_KEY QKT_BROKER_SERVER_TIME_ZONE; do
            test -n "${!name:-}" || { echo "::error::$name is required in the production environment"; exit 1; }
          done
          if [ "${TELEGRAM_ENABLED}" = "true" ]; then
            for name in TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID; do
              test -n "${!name:-}" || { echo "::error::$name is required when TELEGRAM_ENABLED=true"; exit 1; }
            done
          fi
          if [ "${QKT_INSIGHTS_ENABLED}" = "true" ]; then
            for name in QKT_INSIGHTS_INGEST_TOKEN QKT_INSIGHTS_ADMIN_PASSWORD QKT_INSIGHTS_SESSION_SECRET; do
              test -n "${!name:-}" || { echo "::error::$name is required when QKT_INSIGHTS_ENABLED=true"; exit 1; }
            done
          fi

      - name: Render deployment environment
        shell: bash
        run: |
          set -euo pipefail
          umask 077
          {
            printf 'QKT_IMAGE_TAG=%s\n' "$QKT_IMAGE_TAG"
            printf 'MT5_GATEWAY_IMAGE=%s\n' "$MT5_GATEWAY_IMAGE"
            printf 'QKT_BROKER_SERVER_TIME_ZONE=%s\n' "$QKT_BROKER_SERVER_TIME_ZONE"
            printf 'QKT_BROKER_SYMBOL_SUFFIX=%s\n' "$QKT_BROKER_SYMBOL_SUFFIX"
            printf 'QKT_BROKER_MAGIC=%s\n' "$QKT_BROKER_MAGIC"
            printf 'MT5_API_KEY=%s\n' "$MT5_API_KEY"
            printf 'MT5_VNC_USER=%s\n' "$MT5_VNC_USER"
            printf 'MT5_VNC_PASSWORD=%s\n' "$MT5_VNC_PASSWORD"
            printf 'MT5_LOGIN=%s\n' "$MT5_LOGIN"
            printf 'MT5_PASSWORD=%s\n' "$MT5_PASSWORD"
            printf 'MT5_SERVER=%s\n' "$MT5_SERVER"
            printf 'MT5_RESOLVER_URL=%s\n' 'https://mt5.mtapi.io'
            printf 'MT5_LOG_LEVEL=%s\n' 'INFO'
            printf 'COMPOSE_PROJECT_NAME=%s\n' "$COMPOSE_PROJECT_NAME"
            printf 'QKT_BIND_HOST=%s\n' "$QKT_BIND_HOST"
            printf 'MT5_API_HOST_PORT=%s\n' "$MT5_API_HOST_PORT"
            printf 'MT5_VNC_HOST_PORT=%s\n' "$MT5_VNC_HOST_PORT"
            printf 'TELEGRAM_ENABLED=%s\n' "$TELEGRAM_ENABLED"
            printf 'TELEGRAM_BOT_TOKEN=%s\n' "$TELEGRAM_BOT_TOKEN"
            printf 'TELEGRAM_CHAT_ID=%s\n' "$TELEGRAM_CHAT_ID"
            printf 'QKT_ALERTS_WAIVER_REASON=%s\n' "$QKT_ALERTS_WAIVER_REASON"
            printf 'QKT_STARTING_BALANCE=%s\n' "$QKT_STARTING_BALANCE"
            printf 'QKT_MAX_DAILY_LOSS=%s\n' "$QKT_MAX_DAILY_LOSS"
            printf 'QKT_MAX_ORDER_QTY=%s\n' "$QKT_MAX_ORDER_QTY"
            printf 'QKT_MAX_ORDER_NOTIONAL=%s\n' "$QKT_MAX_ORDER_NOTIONAL"
            printf 'QKT_PRICE_COLLAR_PCT=%s\n' "$QKT_PRICE_COLLAR_PCT"
            printf 'QKT_MAX_DRAWDOWN_PCT=%s\n' "$QKT_MAX_DRAWDOWN_PCT"
            printf 'QKT_MAX_DAILY_DRAWDOWN_PCT=%s\n' "$QKT_MAX_DAILY_DRAWDOWN_PCT"
            printf 'QKT_MEASURED_USAGE_HOURS=%s\n' "$QKT_MEASURED_USAGE_HOURS"
            printf 'QKT_INSIGHTS_ENABLED=%s\n' "$QKT_INSIGHTS_ENABLED"
            if [ "$QKT_INSIGHTS_ENABLED" = "true" ]; then
              printf 'COMPOSE_PROFILES=%s\n' 'insights'
            else
              printf 'COMPOSE_PROFILES=\n'
            fi
            printf 'QKT_INSIGHTS_BIND_HOST=%s\n' "$QKT_INSIGHTS_BIND_HOST"
            printf 'QKT_INSIGHTS_HOST_PORT=%s\n' "$QKT_INSIGHTS_HOST_PORT"
            printf 'QKT_INSIGHTS_IMAGE=%s\n' "$QKT_INSIGHTS_IMAGE"
            printf 'QKT_INSIGHTS_INSTANCE_ID=%s\n' "$QKT_INSIGHTS_INSTANCE_ID"
            printf 'QKT_INSIGHTS_INGEST_TOKEN=%s\n' "$QKT_INSIGHTS_INGEST_TOKEN"
            printf 'QKT_INSIGHTS_ADMIN_USERNAME=%s\n' "$QKT_INSIGHTS_ADMIN_USERNAME"
            printf 'QKT_INSIGHTS_ADMIN_PASSWORD=%s\n' "$QKT_INSIGHTS_ADMIN_PASSWORD"
            printf 'QKT_INSIGHTS_SESSION_SECRET=%s\n' "$QKT_INSIGHTS_SESSION_SECRET"
          } > .env

      - name: Configure SSH
        shell: bash
        run: |
          set -euo pipefail
          install -d -m 700 ~/.ssh
          printf '%s\n' "$DEPLOY_SSH_KEY" > ~/.ssh/id_ed25519
          chmod 600 ~/.ssh/id_ed25519
          printf '%s\n' "$DEPLOY_KNOWN_HOSTS" > ~/.ssh/known_hosts
          chmod 600 ~/.ssh/known_hosts

      - name: Validate generated deployment
        shell: bash
        run: docker compose --env-file .env config --quiet

      - name: Parse, compile, and preflight QKT strategies
        shell: bash
        run: |
          set -euo pipefail
          mapfile -t strategies < <(find strategies -maxdepth 1 -type f -name '*.qkt' | sort)
          if [ "${#strategies[@]}" -eq 0 ]; then
            echo "No strategies/*.qkt files to validate"
            exit 0
          fi
          docker compose --env-file .env pull qkt
          for file in "${strategies[@]}"; do
            target="/strategies/$(basename "$file")"
            docker compose --env-file .env run --rm --no-deps --entrypoint qkt qkt parse "$target"
            # Offline preflight performs parse/compile/symbol/risk checks without reaching
            # the live gateway; broker/account validation happens host-side after compose up.
            docker compose --env-file .env run --rm --no-deps --entrypoint qkt qkt preflight "$target" \
              --offline --production --config /etc/qkt/qkt.config.yaml --state-dir /tmp/qkt-preflight-state
          done

      - name: Deploy atomically
        shell: bash
        run: |
          set -euo pipefail
          remote="${DEPLOY_USER}@${DEPLOY_HOST}"
          ssh -p "$DEPLOY_PORT" "$remote" "install -d -m 700 '$DEPLOY_PATH'"
          rsync -az --delete \
            --exclude '.git/' \
            --exclude 'state/' \
            --exclude 'data/' \
            -e "ssh -p $DEPLOY_PORT" \
            ./ "$remote:$DEPLOY_PATH/"
          ssh -p "$DEPLOY_PORT" "$remote" \
            "cd '$DEPLOY_PATH' && chmod 600 .env && docker compose pull && docker compose run --rm init-perms && docker compose run --rm --no-deps -e QKT_PROMOTION_ACTOR='github-actions:$GITHUB_ACTOR' -e QKT_PROMOTION_REASON='protected GitHub production deployment $GITHUB_SHA' --entrypoint /bin/sh qkt /deploy-scripts/approve-promotions.sh && docker compose up -d --remove-orphans && docker compose ps"
          ssh -p "$DEPLOY_PORT" "$remote" \
            "cd '$DEPLOY_PATH' && for attempt in \$(seq 1 60); do docker compose exec -T qkt /bin/sh /deploy-scripts/verify-live.sh && exit 0; sleep 10; done; docker compose logs --tail 200 qkt; exit 1"
