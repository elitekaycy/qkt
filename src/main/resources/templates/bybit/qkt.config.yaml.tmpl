# qkt daemon config. qkt trades Bybit through the qkt-venue-gateway running its Bybit adapter
# (docker-compose.yml starts it), exactly as it trades any other gateway venue. Each `brokers:`
# entry is one trading account, and its name is the prefix strategies use: `bybit_linear` serves
# BYBIT_LINEAR:... symbols, `bybit_spot` serves BYBIT_SPOT:... symbols. One gateway serves one
# Bybit category. To trade spot too, start its gateway (`docker compose --profile spot up -d`)
# and uncomment `bybit_spot` below. qkt checks each gateway's adapter, account and trade mode at
# startup and refuses to start on a mismatch.

state:
  enabled: true

brokers:
  bybit_linear:
    type: gateway
    gateway_url: http://gateway-bybit-linear:8443
    api_key: env:BYBIT_TRADER_TOKEN
    expected_adapter: bybit
    expected_account_login: "${BYBIT_ACCOUNT_LOGIN}"
    expected_trade_mode: ${BYBIT_TRADE_MODE:-demo}
  # bybit_spot:
  #   type: gateway
  #   gateway_url: http://gateway-bybit-spot:8443
  #   api_key: env:BYBIT_TRADER_TOKEN
  #   expected_adapter: bybit
  #   expected_account_login: "${BYBIT_ACCOUNT_LOGIN}"
  #   expected_trade_mode: ${BYBIT_TRADE_MODE:-demo}

notify:
  telegram:
    enabled: ${TELEGRAM_ENABLED}
    bot_token: ${TELEGRAM_BOT_TOKEN}
    chat_id: ${TELEGRAM_CHAT_ID}
    events:
      - daemon_started
      - strategy_error
      - halted
      - resumed
