.PHONY: up down restart logs status list deploy resync resync-dry-run reconcile stop shell

# Bring up the qkt daemon. Bybit is REST API direct — no gateway service to wait on.
up:
	docker compose up -d

# Tear down without removing state.
down:
	docker compose down

restart:
	docker compose restart qkt

# Tail the qkt daemon logs.
logs:
	docker compose logs -f --tail 200 qkt

# Snapshot of all deployed strategies.
status:
	docker compose exec qkt qkt list

# Per-strategy detail.
list:
	docker compose exec qkt qkt list

# Hot-deploy a strategy. Usage: make deploy STRAT=ema_cross
deploy:
	@test -n "$(STRAT)" || (echo "usage: make deploy STRAT=<name>"; exit 1)
	docker compose exec qkt qkt deploy /strategies/$(STRAT).qkt --as $(STRAT)

# Validate a replacement without changing the running strategy.
resync-dry-run:
	@test -n "$(STRAT)" || (echo "usage: make resync-dry-run STRAT=<name>"; exit 1)
	docker compose exec qkt qkt resync /strategies/$(STRAT).qkt --as $(STRAT) --dry-run

# Replace a running strategy under the same daemon name. Usage: make resync STRAT=ema_cross
resync:
	@test -n "$(STRAT)" || (echo "usage: make resync STRAT=<name>"; exit 1)
	docker compose exec qkt qkt resync /strategies/$(STRAT).qkt --as $(STRAT)

# Check qkt's ledger against the live broker/account view.
reconcile:
	@test -n "$(STRAT)" || (echo "usage: make reconcile STRAT=<name>"; exit 1)
	docker compose exec qkt qkt reconcile $(STRAT)

# Stop a deployed strategy. Usage: make stop STRAT=ema_cross
stop:
	@test -n "$(STRAT)" || (echo "usage: make stop STRAT=<name>"; exit 1)
	docker compose exec qkt qkt stop $(STRAT)

# Shell into the qkt container.
shell:
	docker compose exec qkt sh
