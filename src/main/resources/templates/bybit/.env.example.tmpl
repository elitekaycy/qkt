# qkt project secrets — copy to .env and edit before `make up`.
#
# The compose file requires QKT_IMAGE_TAG to be set (no silent-downgrade default).
# Default below pins to the qkt version that scaffolded this project; bump it to
# move to a newer release.
QKT_IMAGE_TAG=v{{QKT_VERSION}}

# The qkt-venue-gateway image. Unset, `make up` builds it once from
# https://github.com/elitekaycy/qkt-venue-gateway (GATEWAY_BUILD_CONTEXT) and tags it
# qkt-venue-gateway:local.
# GATEWAY_IMAGE=qkt-venue-gateway:local
# GATEWAY_BUILD_CONTEXT=https://github.com/elitekaycy/qkt-venue-gateway.git#main

# Gateway bearer tokens: any long random strings (openssl rand -hex 32). qkt sends the
# trader token; guardrails (the kill switch) sends the guardian token.
BYBIT_TRADER_TOKEN=
BYBIT_GUARDIAN_TOKEN=

# Bybit API key. Create one at https://testnet.bybit.com/app/user/api-management for
# testnet or https://www.bybit.com/app/user/api-management for mainnet, with Read-Write
# on Derivatives (and Spot, if you trade it). Never grant withdrawal.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# `testnet`, or `mainnet` for real money. Required: the gateway never defaults it.
BYBIT_ENVIRONMENT=testnet

# What qkt expects the gateway to report before it trades: `demo` on testnet, `real` on
# mainnet, and the account the gateway reports as `account_login` in /v1/health.
BYBIT_TRADE_MODE=demo
BYBIT_ACCOUNT_LOGIN=

# Telegram alerts (optional). Set TELEGRAM_ENABLED=true and provide bot creds to
# turn on. See docs/operations/monitoring.md.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
