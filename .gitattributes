# Check out text files with LF everywhere, including Windows, so generated files and golden
# outputs compare byte for byte on every OS. Windows batch files keep CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Syntax highlighting for .qkt on github.com.
# GitHub only highlights languages that Linguist ships, and qkt is not one yet (Linguist wants the
# extension in wide use across many repositories first), so .qkt borrows the Haskell grammar:
# qkt's UPPERCASE keywords, `--` comments, operators, numbers and strings each get a distinct colour.
# SQL, the previous alias, coloured only a handful of qkt keywords. linguist-detectable=false keeps
# .qkt out of the repository language bar so the repo is not reported as Haskell.
# Local editors use the real grammar under editor/. See docs/how-to/github-syntax-highlighting.md.
*.qkt linguist-language=Haskell linguist-detectable=false

# Import samples are real vendor files: keep their exact bytes (CRLF, UTF-16, BOMs).
src/test/resources/com/qkt/marketdata/ingest/samples/** -text

# Generated by tree-sitter from editor/tree-sitter-qkt/grammar.js.
editor/tree-sitter-qkt/src/** linguist-generated
