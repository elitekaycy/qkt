# Copy to .env and fill the real values. Do not commit .env.

# ---- qkt-insights ---------------------------------------------------------
QKT_INSIGHTS_IMAGE=ghcr.io/elitekaycy/qkt-insights:latest
INGEST_TOKEN=replace-with-a-long-random-ingest-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SESSION_SECRET=replace-with-at-least-32-random-characters
INSIGHTS_PORT=8420

# ---- qkt instance ---------------------------------------------------------
QKT_IMAGE=ghcr.io/elitekaycy/qkt:latest
QKT_INSTANCE_ID=qkt-prod
QKT_STARTING_BALANCE=10000
QKT_RUNTIME_MODE=paper
QKT_MAGIC=4242
QKT_LOG_LEVEL=info
QKT_STATE_ASYNC=true
QKT_INSIGHTS_JOURNAL_ENABLED=true
QKT_INSIGHTS_JOURNAL_DIR=/var/lib/qkt/state/insights-journal

# ---- MT5 gateway / broker -------------------------------------------------
# Use a demo account first. Only switch to a live account after paper validation.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial
MT5_ENABLE_ALGO_TRADING=1
MT5_API_KEY=replace-with-a-long-random-gateway-token
VNC_PASSWORD=replace-with-a-vnc-password
EXNESS_GATEWAY_URL=http://mt5-gateway:5001

# Optional: expose MT5 diagnostic ports only on localhost.
MT5_HTTP_PORT=5001
MT5_VNC_PORT=3000
